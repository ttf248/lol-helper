{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Local Test Lab",
	"version": "3.27.1615",
	"identifier": "cn.localtestlab.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "background",
				"title": "background",
				"url": "src/background/index.html",
				"width": 4,
				"height": 12,
				"visible": false,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
