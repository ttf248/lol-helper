{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Frank: build debug",
			"type": "shell",
			"command": ".\\.vscode\\tauri-msvc.cmd",
			"args": ["tauri", "build", "--debug", "--no-bundle"],
			"options": {
				"cwd": "${workspaceFolder}",
				"shell": {
					"executable": "cmd.exe",
					"args": ["/d", "/c"]
				}
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Frank: Tauri dev",
			"type": "shell",
			"command": ".\\.vscode\\tauri-msvc.cmd",
			"args": ["tauri", "dev"],
			"options": {
				"cwd": "${workspaceFolder}",
				"shell": {
					"executable": "cmd.exe",
					"args": ["/d", "/c"]
				}
			},
			"problemMatcher": []
		}
	]
}
